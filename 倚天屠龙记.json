        },
        {
          "id": "paragraph-1771486897522-cfyh93v1d",
          "content": "山上有一座庙",
          "changes": {
            "elements": [
              {
                "elementId": "location-一座庙-1",
                "elementName": "一座庙",
                "property": "location",
                "from": "当前位置",
